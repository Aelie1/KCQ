{
    "name": "kcq",
    "version": "1.0.0",
    "main": "index.js",
    "directories": {
        "doc": "docs"
    },
    "scripts": {
        "start": "tsx src/main.ts",
        "build": "tsc -p tsconfig.build.json",
        "web": "vite",
        "web:build": "vite build",
        "fight": "tsx src/harness/main.ts",
        "batch": "tsx src/harness/batch-main.ts",
        "compare": "tsx src/harness/compare-main.ts",
        "harness": "tsx src/harness/launcher-main.ts",
        "test": "tsc -p tsconfig.test.json && vitest run",
        "coverage": "vitest --coverage",
        "typecheck": "tsc -p tsconfig.build.json --noEmit && tsc -p tsconfig.web.json --noEmit",
        "typecheck:test": "tsc -p tsconfig.test.json"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/Aelie1/KCQ.git"
    },
    "keywords": [],
    "author": "",
    "license": "ISC",
    "bugs": {
        "url": "https://github.com/Aelie1/KCQ/issues"
    },
    "homepage": "https://github.com/Aelie1/KCQ#readme",
    "description": "",
    "devDependencies": {
        "@types/node": "^26.4.1",
        "@vitest/coverage-v8": "^5.0.0",
        "tsx": "^4.23.13",
        "typescript": "^7.0.2",
        "vite": "^8.2.2",
        "vitest": "^5.0.0"
    },
    "dependencies": {
        "posthog-js": "^1.434.4"
    }
}
