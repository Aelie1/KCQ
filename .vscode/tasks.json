{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "build",
            "type": "shell",
            "command": "${workspaceFolder}\\node_modules\\.bin\\tsc.cmd",
            "args": [
                "-p",
                "${workspaceFolder}\\tsconfig.json"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": "$tsc",
        },
        {
            "label": "tsc watch",
            "type": "shell",
            "command": "npx",
            "args": [
                "tsc",
                "--noEmit",
                "--watch"
            ],
            "isBackground": true,
            "problemMatcher": "$tsc-watch",
            "presentation": {
                "reveal": "never",
                "panel": "dedicated"
            }
        }
    ]
}