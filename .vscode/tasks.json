{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "vite",
            "type": "shell",
            "command": "npm run web",
            "isBackground": true,
            "problemMatcher": {
                "owner": "vite",
                "fileLocation": "absolute",
                "pattern": {
                    "regexp": "^(.+?):(\\d+):(\\d+):\\s+(error|warning)\\s+(.*)$",
                    "file": 1,
                    "line": 2,
                    "column": 3,
                    "severity": 4,
                    "message": 5
                },
                "background": {
                    "activeOnStart": true,
                    "beginsPattern": ".*VITE.*",
                    "endsPattern": "(Local|Network):.*"
                }
            }
        },
        {
            "label": "build",
            "type": "shell",
            "command": "${workspaceFolder}\\node_modules\\.bin\\tsc.cmd",
            "args": [
                "-p",
                "${workspaceFolder}\\tsconfig.build.json"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": "$tsc"
        },
        {
            "label": "tsc watch",
            "type": "shell",
            "command": "npx",
            "args": [
                "tsc",
                "-p",
                "${workspaceFolder}\\tsconfig.test.json",
                "--watch"
            ],
            "isBackground": true,
            "problemMatcher": "$tsc-watch",
            "presentation": {
                "reveal": "never",
                "panel": "dedicated"
            },
            "runOptions": {
                "runOn": "folderOpen"
            }
        },
        {
            "label": "perf",
            "type": "shell",
            "command": "npm run build; node performance/current-bench.cjs plains_1 basic 1000; node performance/current-bench.cjs plains_3 basic 1000; node performance/current-bench.cjs plains_3 escape 300",
            "problemMatcher": []
        },
        {
            "label": "profile",
            "type": "shell",
            "command": "npm run build; node --cpu-prof --cpu-prof-interval=500 --cpu-prof-dir=performance\\profiles --cpu-prof-name=plains1-basic.cpuprofile performance/current-bench.cjs plains_1 basic 1000; node --cpu-prof --cpu-prof-interval=500 --cpu-prof-dir=performance\\profiles --cpu-prof-name=plains3-basic.cpuprofile performance/current-bench.cjs plains_3 basic 1000; node --cpu-prof --cpu-prof-interval=500 --cpu-prof-dir=performance\\profiles --cpu-prof-name=plains3-escape.cpuprofile performance/current-bench.cjs plains_3 escape 300",
            "problemMatcher": []
        },
        {
            "label": "balance smart",
            "type": "process",
            "command": "npm.cmd",
            "args": [
                "run",
                "compare",
                "--",
                "plains_1,plains_2,plains_3,forest_1,forest_2,forest_3",
                "25",
                "smart",
                "1000",
                "--replay-levels",
                "forest_3"
            ],
            "problemMatcher": []
        },
        {
            "label": "balance smart tower",
            "type": "process",
            "command": "npm.cmd",
            "args": [
                "run",
                "compare",
                "--",
                "tower_1,tower_2,tower_3",
                "25",
                "smart",
                "1000",
            ],
            "problemMatcher": []
        },
        {
            "label": "balance smart t1",
            "type": "process",
            "command": "npm.cmd",
            "args": [
                "run",
                "compare",
                "--",
                "tower_1",
                "25",
                "smart",
                "1000",
            ],
            "problemMatcher": []
        },
        {
            "label": "balance smart outside",
            "type": "process",
            "command": "npm.cmd",
            "args": [
                "run",
                "compare",
                "--",
                "outside",
                "25",
                "smart",
                "1000",
            ],
            "problemMatcher": []
        }
    ]
}